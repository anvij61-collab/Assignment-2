import java.util.*;
public class q18multidepartmentmatrixmultiplication {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter no. of rows in 1:");
        int row1 = sc.nextInt();

        System.out.print("Enter no. of col in 1:");
        int col1 = sc.nextInt();

        int[][] one = new int[row1][col1];
        for(int i =0; i<row1 ; i++){
            for(int j =0;  j<col1; j++){
                one[i][j] = sc.nextInt();
            }
        }

        System.out.print("Enter no. of rows in 2:");
        int row2 = sc.nextInt();

        System.out.print("Enter no. of col in 2:");
        int col2 = sc.nextInt();

        int[][] two = new int[row2][col2];
        for(int i =0; i<row2 ; i++){
            for(int j =0;  j<col2; j++){
                two[i][j] = sc.nextInt();
            }
        }

        if(col1 != row2){
            System.out.println("Invalid matrix");
            return;
        }
        int[][] result = new int[row1][col2];
        for(int i =0; i<row1; i++){
            for(int j=0; j<col2;j++){
                for(int k=0; k< col1; k++){
                    result[i][j] += one[i][k] * two[k][j]; 
                }
            }
        }

        for(int i =0; i<row1; i++){
            for(int j=0; j<col2;j++){
                System.out.print(result[i][j] + " ");
            }
        }
        System.out.println();
    }
}
